# Desarrollo local. Se commitea a propósito: no hay ningún secreto acá, es la
# URL de la API corriendo en esta misma máquina, y así `npm run dev` anda de una
# sin que nadie tenga que configurar nada.
#
# Vite sólo carga este archivo en modo development (`npm run dev`). El build de
# producción NO lo lee: ahí VITE_API_URL tiene que venir del entorno —en
# Cloudflare Pages, de Settings → Environment variables— y si falta, el build
# falla a propósito (ver vite.config.js).
#
# El 5035 es el puerto del perfil `http` de la API
# (jalcruz-firstclass-api/Properties/launchSettings.json), que es el que usa
# `dotnet run`. El /api del final es obligatorio: los controllers cuelgan de ahí.
VITE_API_URL=http://localhost:5035/api
